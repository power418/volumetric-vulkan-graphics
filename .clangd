CompileFlags:
  CompilationDatabase: build/
  Add:
    - -std=c++17
    - -I/home/ahmadzanisy/Projects/volumetric-vulkan-graphics
    - -I/home/ahmadzanisy/Projects/volumetric-vulkan-graphics/deps/cache/vulkanmemoryallocator/acb0/include
    - -I/home/ahmadzanisy/Projects/volumetric-vulkan-graphics/deps/cache/miniaudio/ab9e
    - -IC:/VulkanSDK/1.4.350.0/Include
    - -I/home/ahmadzanisy/GNUstep/Library/Headers
    - -I/usr/include/vkd3d
    - -DGNUSTEP
    - -DGNUSTEP_BASE_LIBRARY=1
    - -DGNU_RUNTIME=1
    - -D_NATIVE_OBJC_EXCEPTIONS
    - -fobjc-exceptions
    - -fconstant-string-class=NSConstantString
---
If:
  PathMatch: .*\.h$
CompileFlags:
  Add: 
    - -xobjective-c++-header
---
If:
  PathMatch: .*\.hpp$
CompileFlags:
  Add:
    - -xc++-header
---
If:
  PathMatch: .*\.cpp$
CompileFlags:
  Add:
    - -xc++
---
If:
  PathMatch: .*\.mm$
CompileFlags:
  Add:
    - -xobjective-c++
---
If:
  PathMatch: .*\.m$
CompileFlags:
  Add:
    - -xobjective-c
    - "-I/usr/include/freetype2"
    - "-I/usr/include/libpng16"
