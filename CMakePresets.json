{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "WR_BUILD_APP": "ON",
        "WR_FETCH_DEPS": "ON",
        "WR_COMPILE_SHADER": "OFF",
        "WR_WIN32_EXECUTABLE": "ON",
        "WR_DEBUG_CONSOLE": "ON"
      }
    },
    {
      "name": "base-makefile",
      "hidden": true,
      "inherits": "base",
      "generator": "Unix Makefiles"
    },
    {
      "name": "base-msvc",
      "hidden": true,
      "inherits": "base"
    },
    {
      "name": "windows-x64-vs2026-debug",
      "displayName": "Windows Debug (Visual Studio 2026)",
      "description": "Generate Visual Studio solution/project files for Debug builds.",
      "inherits": "base-msvc",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Visual Studio 18 2026",
      "architecture": "x64"
    },
    {
      "name": "windows-x64-vs2026-release",
      "displayName": "Windows Release (Visual Studio 2026)",
      "description": "Generate Visual Studio solution/project files for Release builds.",
      "inherits": "base-msvc",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "cacheVariables": {
        "WR_DEBUG_CONSOLE": "OFF"
      }
    },
    {
      "name": "windows-x64-makefile-debug",
      "displayName": "Windows Debug (Ninja)",
      "description": "Single-config Debug build for clangd compile_commands.json on Windows.",
      "inherits": "base-makefile",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-x64-makefile-release",
      "displayName": "Windows Release (Ninja)",
      "description": "Single-config Release build for clangd compile_commands.json on Windows.",
      "inherits": "base-makefile",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "WR_DEBUG_CONSOLE": "OFF"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug (Ninja)",
      "inherits": "base-makefile",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release (Ninja)",
      "inherits": "base-makefile",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "WR_DEBUG_CONSOLE": "OFF"
      }
    },
    {
      "name": "linux-mingw-base",
      "hidden": true,
      "inherits": "base-makefile",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/mingw-w64-x86_64.cmake",
        "WR_WIN32_EXECUTABLE": "ON"
      }
    },
    {
      "name": "linux-mingw-debug",
      "displayName": "Windows Debug from Linux (MinGW-w64 + Ninja)",
      "inherits": "linux-mingw-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-mingw-release",
      "displayName": "Windows Release from Linux (MinGW-w64 + Ninja)",
      "inherits": "linux-mingw-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "WR_DEBUG_CONSOLE": "OFF"
      }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS Debug (Ninja)",
      "inherits": "base-makefile",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-release",
      "displayName": "macOS Release (Ninja)",
      "inherits": "base-makefile",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "WR_DEBUG_CONSOLE": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-vs2026-debug",
      "displayName": "Build Windows Debug (Visual Studio 2026)",
      "configurePreset": "windows-x64-vs2026-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-vs2026-release",
      "displayName": "Build Windows Release (Visual Studio 2026)",
      "configurePreset": "windows-x64-vs2026-release",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-makefile-debug",
      "displayName": "Build Windows Debug (Ninja)",
      "configurePreset": "windows-x64-makefile-debug"
    },
    {
      "name": "windows-x64-makefile-release",
      "displayName": "Build Windows Release (Ninja)",
      "configurePreset": "windows-x64-makefile-release"
    },
    {
      "name": "linux-debug",
      "displayName": "Build Linux Debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "displayName": "Build Linux Release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-mingw-debug",
      "displayName": "Build Windows Debug from Linux",
      "configurePreset": "linux-mingw-debug"
    },
    {
      "name": "linux-mingw-release",
      "displayName": "Build Windows Release from Linux",
      "configurePreset": "linux-mingw-release"
    },
    {
      "name": "macos-debug",
      "displayName": "Build macOS Debug",
      "configurePreset": "macos-debug"
    },
    {
      "name": "macos-release",
      "displayName": "Build macOS Release",
      "configurePreset": "macos-release"
    }
  ]
}
